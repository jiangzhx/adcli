{
  "name": "@jiangzhx/kuaishou-marketing-api",
  "version": "1.10.1-port.1",
  "description": "TypeScript SDK ported from github.com/bububa/kwai-marketing-api for Kuaishou Magnetic Engine Marketing API.",
  "homepage": "https://github.com/jiangzhx/kuaishou-marketing-api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiangzhx/kuaishou-marketing-api.git"
  },
  "bugs": {
    "url": "https://github.com/jiangzhx/kuaishou-marketing-api/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "import": "./dist/model/index.js"
    },
    "./api/oauth": {
      "types": "./dist/api/oauth/index.d.ts",
      "import": "./dist/api/oauth/index.js"
    },
    "./api/advertiser": {
      "types": "./dist/api/advertiser/index.d.ts",
      "import": "./dist/api/advertiser/index.js"
    },
    "./api/dsp/campaign": {
      "types": "./dist/api/dsp/campaign/index.d.ts",
      "import": "./dist/api/dsp/campaign/index.js"
    },
    "./api/dsp/unit": {
      "types": "./dist/api/dsp/unit/index.d.ts",
      "import": "./dist/api/dsp/unit/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "test": "bun test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "typescript": ">=5"
  },
  "devDependencies": {
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^20",
    "typescript": "^5"
  },
  "dependencies": {
    "json-bigint": "^1.0.0"
  }
}
